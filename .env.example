# Copy to .env.local (and add the same values in Vercel → Project → Settings →
# Environment Variables). Same Supabase project/values as the agent project.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase service-role key (server-only — never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Password for /dashboard
ADMIN_PASSWORD=

# Optional: dedicated salt for the daily visitor hash (falls back to ADMIN_PASSWORD)
ANALYTICS_SALT=
